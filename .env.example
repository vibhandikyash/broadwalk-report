# Where uploads, the SQLite DB and generated reports live. Relative paths are taken from the repository root,
# whichever directory the backend is started from. Absolute paths work too.
APP_DATA_DIR=backend/data
# Parallel file-processing workers
APP_WORKERS=3
# Max upload size per file, MB
APP_MAX_UPLOAD_MB=50
# Comma-separated origins allowed by CORS (Angular dev server)
APP_CORS_ORIGINS=http://localhost:4200
# Port the backend listens on; the Angular dev proxy reads this too (start uvicorn with --port to match)
BACKEND_PORT=8000
# OPTIONAL: AI narrative drafting. Leave everything unset to run fully offline (the button is hidden).
# One of: auto | api | agent-sdk | off
# NARRATIVE_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# OPTIONAL: Gemini vision OCR for scanned or image-only PDF pages. When unset, those pages stay local
# and are marked as needing OCR. Setting this sends only affected page images to the Gemini API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OCR_DPI=200
# OCR_TIMEOUT_SECONDS=60
# OCR_MIN_TEXT_CHARS=20

# OPTIONAL: annex the generated PDF with the data-source sheets that say, for every value, which file
# and line it came from, whether OCR was needed, and why a dash is a dash. The delivered report carries
# values only, so leave this false for a client deliverable and turn it on to demonstrate the workflow.
REPORT_PROVENANCE=false
